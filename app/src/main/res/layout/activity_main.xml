<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/screen_bg" android:orientation="vertical">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/tvHalo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Halo, Safna! 👋" android:textColor="@color/text_dark"
                android:textSize="22sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Selamat datang di LaundryKu" android:textColor="@color/text_dark" />

            <com.google.android.material.card.MaterialCardView android:id="@+id/cardSaldo"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" app:cardBackgroundColor="@color/primary"
                app:cardCornerRadius="16dp" app:cardElevation="3dp"
                android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:padding="18dp">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp"
                        android:src="@drawable/ic_wallet" app:tint="@android:color/white" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Saldo Anda" android:textColor="@android:color/white" />
                        <TextView android:id="@+id/tvSaldo" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="Rp 50.000"
                            android:textColor="@android:color/white" android:textSize="24sp" android:textStyle="bold" />
                    </LinearLayout>
                    <ImageView style="@style/Chevron" app:tint="@android:color/white" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardPesan" style="@style/MenuCard">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:gravity="center" android:orientation="vertical">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp"
                            android:src="@drawable/ic_shirt" app:tint="@color/primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:gravity="center" android:text="Pesan\nLaundry"
                            android:textColor="@color/text_dark" android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardRiwayat" style="@style/MenuCard">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:gravity="center" android:orientation="vertical">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp"
                            android:src="@drawable/ic_history" app:tint="@color/primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:gravity="center" android:text="Riwayat\nTransaksi"
                            android:textColor="@color/text_dark" android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardTopup" style="@style/MenuCard">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:gravity="center" android:orientation="vertical">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp"
                            android:src="@drawable/ic_wallet" app:tint="@color/primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:gravity="center" android:text="Top Up\nSaldo"
                            android:textColor="@color/text_dark" android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardSetting" style="@style/MenuCard">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:gravity="center" android:orientation="vertical">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp"
                            android:src="@drawable/ic_settings" app:tint="@color/primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:gravity="center" android:text="Pengaturan"
                            android:textColor="@color/text_dark" android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Info Terbaru" android:textColor="@color/text_dark"
                    android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvLihatSemua" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Lihat Semua ›"
                    android:textColor="@color/primary" android:textSize="12sp" />
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                app:cardCornerRadius="14dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp"
                        android:src="@drawable/ic_megaphone" app:tint="@color/orange" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:text="Promo cuci 2kg\nhanya Rp 15.000!"
                        android:textColor="@color/text_dark" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
