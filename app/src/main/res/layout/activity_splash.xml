<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#E3EEFF" android:gravity="center" android:orientation="vertical">
    <ImageView android:layout_width="130dp" android:layout_height="130dp"
        android:src="@drawable/ic_shirt" app:tint="@color/primary" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="LaundryKu"
        android:textColor="@color/primary" android:textSize="38sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="Bersih, Rapi, dan Praktis"
        android:textColor="@color/text_dark" android:textSize="16sp" />
    <ProgressBar android:layout_width="40dp" android:layout_height="40dp"
        android:layout_marginTop="60dp" android:indeterminateTint="@color/primary" />
</LinearLayout>
